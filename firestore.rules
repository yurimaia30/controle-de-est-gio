rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data; }
    function admin() { return signed() && profile().role == 'admin' && profile().name in ['Yuri Maia', 'Luiz Paulo']; }
    function access(group) { return admin() || (signed() && profile().role == 'field' && profile().group == group); }
    match /profiles/{uid} { allow read: if signed() && (request.auth.uid == uid || admin()); allow write: if false; }
    match /fields/{id} { allow read: if admin() || access(resource.data.group); allow write: if admin(); }
    match /students/{id} { allow read, write: if admin(); }
    match /settings/{id} { allow read, write: if admin(); }
    match /radcontrol/{id} { allow read: if admin(); allow write: if false; }
    match /opportunities/{id} {
      allow read: if admin() || access(resource.data.group);
      allow create: if admin() && request.resource.data.dates.size() > 0 && request.resource.data.hours > 0 && request.resource.data.hours <= 24;
      allow update, delete: if false;
    }
    match /attendance/{id} {
      function op() { return get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data; }
      allow read: if admin() || access(resource.data.group);
      allow create, update: if access(request.resource.data.group)
        && request.resource.data.keys().hasOnly(['opportunityId','group','date','dateAt','status','recordedBy','updatedAt'])
        && request.resource.data.group == op().group
        && id == request.resource.data.opportunityId + '_' + request.resource.data.date
        && request.resource.data.date in op().dates
        && request.resource.data.dateAt == op().dateTimes[request.resource.data.date]
        && request.resource.data.dateAt <= request.time
        && request.resource.data.status in ['presente','falta']
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/approvals/$(request.resource.data.opportunityId));
      allow delete: if false;
    }
    match /approvals/{id} {
      function op() { return get(/databases/$(database)/documents/opportunities/$(id)).data; }
      allow read: if admin();
      allow create: if admin() && op().endAt < request.time
        && request.resource.data.keys().hasOnly(['studentId','hours','approvedBy','approvedName','approvedAt','presentDates','group'])
        && request.resource.data.studentId == op().studentId
        && request.resource.data.group == op().group
        && request.resource.data.hours >= 0
        && request.resource.data.hours == request.resource.data.presentDates.size() * op().hours
        && request.resource.data.presentDates.hasOnly(op().dates)
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.approvedName == profile().name
        && request.resource.data.approvedAt == request.time;
      allow update, delete: if false;
    }
  }
}
